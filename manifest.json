{
  "manifest_version": 2,
  "name": "1ClickSVG",
  "version": "1.2.0",
  "description": "Option/Alt + click saves any SVG or image (PNG, JPG, WebP…) from a web page. Add Shift to copy it instead.",
  "homepage_url": "https://github.com/TeeVy/1ClickSVG",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "downloads",
    "clipboardWrite",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "1clicksvg@robin.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
